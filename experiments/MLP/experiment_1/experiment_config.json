{
  "dataset_name": "full_train_dataset_with_embeddings.parquet",
  "test_size": 0.2,
  "random_state": 42,
  "batch_size": 256,
  "learning_rate": 0.001,
  "optimizer": "Adam",
  "loss_function": "mse",
  "num_epochs": 15,
  "validation_split": 0.2,
  "input_vectors": [
    {
      "columns": [
        "UserID",
        "Age",
        "occupation_encoded",
        "Zipcode_endcoded",
        "Gender_M",
        "Gender_F"
      ]
    },
    {
      "columns": [
        "Action",
        "Adventure",
        "Animation",
        "Children's",
        "Comedy",
        "Crime",
        "Documentary",
        "Drama",
        "Fantasy",
        "Film-Noir",
        "Horror",
        "Musical",
        "Mystery",
        "Romance",
        "Sci-Fi",
        "Thriller",
        "War",
        "Western",
        "adult"
      ]
    },
    {
      "columns": [
        "popularity",
        "vote_average",
        "vote_count",
        "original_langage_encoded"
      ]
    }
  ],
  "target_column": "Rating"
}